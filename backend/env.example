# Copy the lines you need into your shell or process manager. All are optional.

# mock = offline rule-based simulation (default); openai = any OpenAI-compatible endpoint
CROWDPOD_LLM_PROVIDER=mock
CROWDPOD_LLM_BASE_URL=
CROWDPOD_LLM_API_KEY=
CROWDPOD_LLM_MODEL=
# parallel model calls, and personas judged per call
CROWDPOD_LLM_CONCURRENCY=4
CROWDPOD_CROWD_BATCH_SIZE=20

# browser sessions in parallel; set HEADLESS=0 to watch the browsers
CROWDPOD_HANDS_CONCURRENCY=2
CROWDPOD_HANDS_HEADLESS=1

# defaults: ../vault and ../data relative to backend/
# CROWDPOD_VAULT_DIR=
# CROWDPOD_DATA_DIR=
