# Copy the lines you need into your shell or process manager. All are optional.

# mock = offline rule-based simulation (default); anthropic = Claude; openai = any OpenAI-compatible endpoint
CROWDPOD_LLM_PROVIDER=mock
CROWDPOD_LLM_BASE_URL=
CROWDPOD_LLM_API_KEY=
CROWDPOD_LLM_MODEL=
# parallel model calls, and personas judged per call
CROWDPOD_LLM_CONCURRENCY=4
CROWDPOD_CROWD_BATCH_SIZE=20

# browser sessions in parallel; set HEADLESS=0 to watch the browsers
CROWDPOD_HANDS_CONCURRENCY=2
CROWDPOD_HANDS_HEADLESS=1

# defaults: ../vault and ../data relative to backend/
# CROWDPOD_VAULT_DIR=
# CROWDPOD_DATA_DIR=

# Settings saved in the app (data/settings.json) take over from the values above.
# Extra Host names the API answers to, comma-separated (default: 127.0.0.1, localhost)
# CROWDPOD_ALLOWED_HOSTS=
# Where the MCP server finds the running API
# CROWDPOD_API_URL=http://127.0.0.1:8000

# Sign-in (on by default). CROWDPOD_AUTH=off disables it on a private machine.
# CROWDPOD_AUTH=on
# Google sign-in: an OAuth client you create in Google Cloud (see README → Sign-in)
# CROWDPOD_GOOGLE_CLIENT_ID=
# CROWDPOD_GOOGLE_CLIENT_SECRET=
# Where the API and web app are reached in the browser (Google redirects back here)
# CROWDPOD_PUBLIC_URL=http://127.0.0.1:8000
# CROWDPOD_APP_URL=http://127.0.0.1:3000

# ---- Hosting for other people (see docs/DEPLOY.md and SECURITY.md) ----
# public = strict per-user limits, admin-only settings, browsers can't reach private networks
# CROWDPOD_MODE=public
# you: the admin console and the model settings
# CROWDPOD_ADMIN_EMAILS=you@gmail.com
# security alerts by email (default: the admins); any SMTP server, e.g. Gmail with an app password
# CROWDPOD_ALERT_EMAILS=
# CROWDPOD_SMTP_HOST=smtp.gmail.com
# CROWDPOD_SMTP_PORT=587
# CROWDPOD_SMTP_USER=
# CROWDPOD_SMTP_PASSWORD=
# CROWDPOD_SMTP_FROM=
# extra web origins allowed to call the API with cookies (the app URL is always allowed)
# CROWDPOD_ALLOWED_ORIGINS=
# behind a proxy (Vercel, a load balancer): read the client address from X-Forwarded-For
# CROWDPOD_TRUST_PROXY=1
# where people's agents install the MCP server from
# CROWDPOD_SOURCE_URL=https://github.com/you/crowdpod
